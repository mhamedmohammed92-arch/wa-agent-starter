# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is git-ignored. Never commit it, and never paste a token into a chat, an
# issue or a screenshot: a WhatsApp token is enough for someone else to send
# messages as your business.
#
# Every value below is EMPTY on purpose. Nothing here is a working credential.


# --- Meta WhatsApp Cloud API --------------------------------------------- #

# Access token used to send messages.
# Meta app dashboard -> WhatsApp -> API Setup -> "Temporary access token"
# (24 hours, fine for the first test). For anything permanent, create a System
# User in Meta Business Settings and generate a token with the
# whatsapp_business_messaging and whatsapp_business_management permissions.
WHATSAPP_TOKEN=

# The "Phone number ID" shown on the same API Setup page. It is a long number,
# and it is NOT the phone number itself. Copy the ID, not the number.
WHATSAPP_PHONE_ID=

# A string you invent yourself, right now. Any random text will do.
# You paste the SAME value into Meta's callback form ("Verify token"), and Meta
# sends it back once during the GET handshake so both sides prove they agree.
# Example shape only: 3 to 5 random words, or 32 random characters.
WHATSAPP_VERIFY_TOKEN=

# App Secret: Meta app dashboard -> App settings -> Basic -> App Secret (Show).
# Every inbound POST is signed with it (X-Hub-Signature-256), and this app
# rejects any request whose signature does not match. Leave it empty and every
# webhook POST is refused - that is deliberate, not a bug.
META_APP_SECRET=

# Graph API version to call. Bump it when you move to a newer one.
GRAPH_API_VERSION=v21.0

# Graph API host. Only change this if you route through a solution partner that
# exposes a Graph-compatible endpoint.
GRAPH_API_BASE=https://graph.facebook.com


# --- Agent behaviour ------------------------------------------------------ #

# Path to the answer book. Relative paths resolve against the project root.
# Point this at your own copy to keep your answers out of the repository.
FAQ_FILE=faq.json

# Reply language when the incoming message carries no script to detect: an
# emoji, a bare number, a voice note. One of: he, ar, en.
DEFAULT_LANGUAGE=he

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO


# --- Local development only ----------------------------------------------- #

# Set to true to skip signature verification while testing on your own machine
# with a hand-made request. NEVER set this to true on a public URL: it turns the
# webhook into an open remote control for anyone who finds the address.
ALLOW_UNSIGNED_WEBHOOK=false
